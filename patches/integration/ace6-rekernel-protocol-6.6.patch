diff --git a/drivers/rekernel/rekernel.h b/drivers/rekernel/rekernel.h
--- a/drivers/rekernel/rekernel.h
+++ b/drivers/rekernel/rekernel.h
@@ -8,6 +8,8 @@ struct task_struct;
 #define REKERNEL_NETLINK_MIN 22
 #define REKERNEL_USER_PORT 100
 #define REKERNEL_PACKET_SIZE 128
+#define REKERNEL_PROTOCOL_VERSION 1
+#define REKERNEL_MAX_PAYLOAD (REKERNEL_PACKET_SIZE - 1)
 #define REKERNEL_MIN_USERAPP_UID 10000
 #define REKERNEL_MAX_SYSTEM_UID 2000
 #define REKERNEL_WARN_AHEAD_SPACE (1U << 17)
diff --git a/drivers/rekernel/rekernel.c b/drivers/rekernel/rekernel.c
--- a/drivers/rekernel/rekernel.c
+++ b/drivers/rekernel/rekernel.c
@@ -132,4 +132,4 @@ int rekernel_send_netlink(const char *message, size_t length)
 	int ret;
 
-	if (!message || !length || length > REKERNEL_PACKET_SIZE)
+	if (!message || !length || length > REKERNEL_MAX_PAYLOAD)
 		return -EMSGSIZE;
